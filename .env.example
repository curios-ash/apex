# Local default matches docker-compose.yml — no cloud accounts needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apex

# --- Slice 2: ingestion + LLM pipeline (all optional locally) ---

# Vercel Blob private store. Unset => files go to local disk (.data/files).
# BLOB_READ_WRITE_TOKEN=

# Local disk fallback directory (default: ./.data/files).
# APEX_STORAGE_DIR=

# LLM. Unset keys => deterministic mock provider (tests/CI need nothing).
# Production path: Vercel AI Gateway. Anthropic is not required.
# AI_GATEWAY_API_KEY=
# APEX_LLM_MODEL=google/gemini-3.1-flash-lite
# Upgrade only if /verify is too noisy:
# APEX_LLM_MODEL=google/gemini-3.1-flash
# APEX_LLM_MODEL=anthropic/claude-sonnet-5
# Optional leftover (not required):
# ANTHROPIC_API_KEY=

# Inbound email. Domain your aliases live under (<slug>@<domain>).
# INBOUND_EMAIL_DOMAIN=in.apex.example.com
# Shared secret checked via ?secret= or x-inbound-secret header (optional).
# INBOUND_EMAIL_SECRET=

# Which workspace the internal pages (/upload, /verify) operate on.
# Default: oldest workspace; a "demo" workspace is auto-created on first run.
# APEX_WORKSPACE_SLUG=demo

# Extractions with any field below this confidence land in /verify (0..1).
# EXTRACTION_REVIEW_THRESHOLD=0.85

# --- Slice 5: approval queue + renewal calendar (all optional locally) ---

# Bearer token required on the Vercel cron endpoints
# (/api/cron/monthly-review, /api/cron/renewal-reminders). Unset => open
# locally; always set it in preview/prod so the cron is not a public GET.
# CRON_SECRET=

# Model for Coordinator drafts (PM follow-ups, quote requests, reminders).
# Unset => same pin as APEX_LLM_MODEL (google/gemini-3.1-flash-lite).
# APEX_DRAFT_MODEL=google/gemini-3.1-flash-lite

# RentCast comps for the underwriter. Unset => deterministic mock-rentcast-v1
# (same pattern as the LLM mock). Live key optional; never needed for tests.
# RENTCAST_API_KEY=
# RENTCAST_BASE_URL=https://api.rentcast.io/v1

# Buyer address lookup (Slice A/B). Unset => mock-places-v1 seed addresses
# plus free-text create. Never required for tests or local demo.
# GOOGLE_MAPS_API_KEY=

# Optional live Census Bureau geocoder for county/coordinates on ingest.
# Unset/false => mock-census-v1 parser from the address. No API key.
# CENSUS_GEOCODER_ENABLED=true

# --- Slice 6: self-serve auth + billing (all optional locally) ---

# Dev-mode sign-in (email + workspace picker, no password). Enables /sign-in.
# After sign-in the app lands on /deals (Find). Clearly marked DEV in the UI.
# Never enable in production — Clerk replaces it (see README "Auth").
# APEX_DEV_AUTH_ENABLED=true
# Signing secret for the dev session cookie (default is well-known; fine locally).
# APEX_DEV_AUTH_SECRET=

# Clerk (production auth). Set by the Vercel Marketplace install; the app
# prefers Clerk sessions automatically once both keys exist. Also set allowed
# redirect URLs / origins in the Clerk dashboard (see README "Auth — Clerk").
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Optional path hints for hosted components / middleware redirects:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/deals
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/deals

# Stripe billing. Keep unset/off — mock catalog + DB plan switcher.
# Do not set STRIPE_ENABLED unless we explicitly go live with Checkout.
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids from the Stripe dashboard (README "Stripe setup"):
# STRIPE_PRICE_OWNER_BASE=price_...
# STRIPE_PRICE_OWNER_DOOR=price_...
# STRIPE_PRICE_PORTFOLIO_BASE=price_...
# STRIPE_PRICE_PORTFOLIO_DOOR=price_...
